{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ve-moi",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "vemoi.vanhoacantho.vn/*", "zone_name": "digi247.io.vn" }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["STAFF_PASSWORD", "STAFF_SECRET", "CHECKIN_PASSWORD"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VENUE", "class_name": "Venue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Venue"] }
  ]
}
